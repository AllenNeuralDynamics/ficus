# Ficus settings. Copy to .env, or pass them as environment variables (e.g. `docker run --env-file`).
# Environment variables win over .env. Every value below is the default.

# Where configs are stored: zookeeper or file_system.
STORE=zookeeper
# ZooKeeper root node, or the folder for file_system.
ROOT_DIR=scratch
# Scope precedence, lowest first, as a JSON list: subject_id files override hostname files.
SCOPES=["hostname", "subject_id"]

# ZooKeeper ensemble, comma-separated host:port (or a JSON list). Older name: ZK_HOST.
ZK_HOSTS=eng-logtools:2181
# Seconds to wait for a ZooKeeper connection before a request fails.
ZK_TIMEOUT=15

# Path prefix the API is served under, e.g. /ficus gives http://localhost:8000/ficus/docs (older
# name: API_NAME). Leave it empty behind a proxy that strips the prefix and sends X-Forwarded-Prefix
# (Traefik's stripprefix does): the docs then follow whatever prefix the proxy uses.
ROOT_PATH=
# TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
